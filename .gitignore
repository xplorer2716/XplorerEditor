# Xplorer — JUCE C++ Application
# .gitignore for C++ development with JUCE, CMake, and MSVC/Clang/GCC
# Ignores build artifacts, IDE caches, and generated files
# No .NET entries — this is a pure C++ project

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENVIRONMENT & SECRETS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Environment variables and local configuration files that should not be shared
.env
.env.local
.env.*.local

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VISUAL STUDIO (2015-2026) IDE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Hidden .vs folder contains all IDE caches, breakpoints, debugging state, and user settings
.vs/

# User-specific Visual Studio project settings and solution metadata
*.user
*.userosscache
*.sln.docstates

# Visual C++ IntelliSense and project-specific caches
*.VC.db
*.VC.VC.opendb

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VISUAL STUDIO CODE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VSCode workspace folder is version-controlled for consistency, but ignore user-specific settings
# Keep .vscode/ if it contains repo-level extensions.json or settings.json meant to be shared
# Ignore only the personal user settings and launch configurations
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.history/

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CMAKE BUILD OUTPUT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CMake generates build directories named build* (build-win, build-unix, build-win-local, etc.)
# Each contains all generated binaries, object files, intermediate artifacts, and CMake metadata
# Anchored to the repo root and to juce/ so this never shadows an unrelated directory that
# happens to start with "build" elsewhere in the tree (e.g. .github/actions/build-app/).
/build*/
/juce/build*/

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COMPILER & LINKER ARTIFACTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Object files produced by C++ compilation on all platforms
*.o
*.obj

# Static and shared libraries produced by linker
*.a
*.lib
*.so
*.dylib
*.dll

# Compiled headers, precompiled header files, and intermediate C++ compilation outputs
*.pch
*.iobj
*.ipdb
*.pdb

# Visual C++ IntelliSense database and related caches
ipch/
*.ncb
*.opensdf
*.sdf
*.aps

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BUILD LOGS & DIAGNOSTICS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Build system output, compiler warnings, errors, and diagnostics from all platforms
*.log
*.tlog
*.sbr
*.bak
*~

# Test runner and diagnostic output
*.VisualState.xml
TestResult.xml

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JUCE-GENERATED CODE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JUCE generates JuceLibraryCode/ and binary data C++ files during CMake configure
# These are always regenerated from source, so they should never be version-controlled
JuceLibraryCode/
*_artefacts/
BinaryData.cpp
BinaryData.h

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PROFILER & INSTRUMENTATION DATA
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Performance profiler outputs and code coverage reports (temporary, generated locally)
*.psess
*.vsp
*.vspx
*.coverage
*.coveragexml

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TEMPORARY & OS-SPECIFIC FILES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# macOS system and backup files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows system and backup files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux/Unix editor and shell temporary files
*.swp
*.swo
*~

# JetBrains IDEs (if ReSharper C++ or CLion are used alongside VS/VSCode)
.idea/
*.sln.iml

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MISCELLANEOUS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Python cache and bytecode (for any build tools or scripts)
__pycache__/
*.pyc

# Node.js modules (in case any tooling or CI uses npm)
node_modules/
